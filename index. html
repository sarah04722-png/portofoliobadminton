        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Achievements Filter Logic
        const filterBtns = document.querySelectorAll('.achieve-filter');
        const achieveCards = document.querySelectorAll('.achievement-card');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                // Update active tab styling
                filterBtns.forEach(b => {
                    b.classList.remove('bg-brand-neon', 'text-brand-black', 'active');
                    b.classList.add('bg-brand-card', 'text-gray-300');
                });
                btn.classList.add('bg-brand-neon', 'text-brand-black', 'active');
                btn.classList.remove('bg-brand-card', 'text-gray-300');

                const filter = btn.getAttribute('data-filter');

                achieveCards.forEach(card => {
                    if (filter === 'all' || card.classList.contains(filter)) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });

        // Form Submit Simulation
        const contactForm = document.getElementById('contactForm');
        const formAlert = document.getElementById('formAlert');

        contactForm.addEventListener('submit', (e) => {
            e.preventDefault();
            
            // Show success message
            formAlert.classList.remove('hidden');
            contactForm.reset();

            // Auto hide after 5 seconds
            setTimeout(() => {
                formAlert.classList.add('hidden');
            }, 5000);
        });
    </script>u
</body>
